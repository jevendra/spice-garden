pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/jevendra/spice-garden.git'
            }
        }

        stage('Build') {
    steps {
        sh '''
            echo "=== JAVA ==="
            java -version

            echo "=== JAVAC ==="
            javac -version

            echo "=== MAVEN ==="
            mvn -version

            echo "=== JAVA_HOME ==="
            echo $JAVA_HOME

            mvn clean package -DskipTests
        '''
    }
}

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

    }

    post {
        success {
            echo 'Spice Garden Pipeline SUCCESS!'
        }

        failure {
            echo 'Spice Garden Pipeline FAILED!'
        }
    }
}
